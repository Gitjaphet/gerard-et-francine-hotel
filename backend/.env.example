# Environnement : development | staging | production
APP_ENV=development
APP_DEBUG=true

# Clé de signature des jetons (min. 32 caractères) — générer avec : openssl rand -hex 32
APP_SECRET_KEY=remplacer-par-une-vraie-cle-de-32-caracteres-minimum

# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://hotel:hotel@localhost:5432/hotel_dev

# Origines autorisées (format JSON)
CORS_ORIGINS=["http://localhost:3000"]
