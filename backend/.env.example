# Environnement : development | staging | production
APP_ENV=development
APP_DEBUG=true

# Clé de signature des jetons (min. 32 caractères) — générer avec : openssl rand -hex 32
APP_SECRET_KEY=remplacer-par-une-vraie-cle-de-32-caracteres-minimum

# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://hotel:hotel@localhost:5432/hotel_dev

# Origines autorisées (format JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Emails : "console" affiche les emails dans le terminal (développement),
# "smtp" les envoie réellement. Pour Gmail, SMTP_PASSWORD est un mot de passe
# d'application (validation en deux étapes requise), jamais le mot de passe du compte.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
RECEPTION_EMAIL=
ADMIN_BASE_URL=http://localhost:3000/admin
